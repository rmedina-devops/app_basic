{
    "name": "renzomedina/sample",
    "description": "This is project template for FlightPHP",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "test": "phpunit",
        "changelog": "conventional-changelog",
        "first-release": "conventional-changelog --first-release --annotate-tag",
        "history-release": "conventional-changelog --history",
        "release": "conventional-changelog --commit --annotate-tag"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "authors": [
        {
            "name": "RenzoMedina",
            "email": "medinast30@gmail.com"
        }
    ],
    "require": {
        "flightphp/core": "^3.19",
        "eftec/bladeone": "^5.0",
        "vlucas/phpdotenv": "^5.8",
        "level-2/dice": "^4.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "marcocesarato/php-conventional-changelog": "^1.17"
    },
    "version": "1.0.3"
}